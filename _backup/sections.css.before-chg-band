/* ==========================================================================
   5. WHAT YOU WANT · three jobs + "red line" slider chart
   ========================================================================== */
.jobs {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 300px));   /* narrower columns, so the
                                        lines read comfortably (were 1fr, ~420px on 16") */
  gap: 40px 64px;                    /* no plates: more air instead */
  margin-top: 48px;                  /* +10% after the title (was 44px) */
}

.job { padding: 0; }   /* no plate: icon and text stand on the page */

/* Icons: 2× size (was 42px), animated in a loop. Same language for all
   three: grey track, one brand-gradient stroke, the rest white.
   Source and the other options: concepts/icons/ */
.job svg { display: block; width: 97px; height: 97px; margin-bottom: 18px; overflow: visible; }   /* +15% */
.ji * { transform-box: view-box; }

/* Each icon plays once, one after another, when the row scrolls into view
   (sections.js adds .play; it is removed when the row leaves, so it replays) */
.jobs:not(.play) .ji * { animation-play-state: paused !important; animation-name: none !important; }
.jobs .job:nth-child(2) .ji * { animation-delay: .9s; }
.jobs .job:nth-child(3) .ji * { animation-delay: 1.8s; }

/* Your time back · the clock runs backwards, the ring fills back up */
.ji-rewind .ring {
  stroke-dasharray: 201;
  transform: rotate(-90deg);
  transform-origin: 42px 42px;
  animation: jiRingFill 3.2s cubic-bezier(.6, 0, .3, 1) both;
}
.ji-rewind .hand-m { transform-origin: 42px 42px; animation: jiSpinBack 3.2s cubic-bezier(.6, 0, .3, 1) both; }
.ji-rewind .hand-h { transform-origin: 42px 42px; animation: jiSpinBackSlow 3.2s cubic-bezier(.6, 0, .3, 1) both; }
.ji-rewind .back { animation: jiNudge 3.2s ease-in-out both; }

@keyframes jiRingFill { 0% { stroke-dashoffset: 201; } 70%, 100% { stroke-dashoffset: 0; } }
@keyframes jiSpinBack { 0% { transform: rotate(0); } 70%, 100% { transform: rotate(-720deg); } }
@keyframes jiSpinBackSlow { 0% { transform: rotate(0); } 70%, 100% { transform: rotate(-60deg); } }
@keyframes jiNudge { 0%, 60%, 100% { transform: translate(0, 0); } 30% { transform: translate(-2px, -2px); } }

/* Profitable growth · the line draws up, a violet dot rides it, then the arrow */
.ji-climb .line { stroke-dasharray: 90; animation: jiDraw 3.4s cubic-bezier(.6, 0, .3, 1) both; }
.ji-climb .area { animation: jiAreaIn 3.4s ease both; }
.ji-climb .arrow { transform-origin: 70px 20px; animation: jiArrowPop 3.4s cubic-bezier(.3, 1.6, .5, 1) both; }
.ji-climb .rider {
  fill: #8E4BEA;
  stroke: #fff;
  stroke-width: 2;
  offset-path: path("M10 64 L28 48 L42 56 L70 20");
  offset-rotate: 0deg;
  animation: jiRide 3.4s cubic-bezier(.6, 0, .3, 1) both;
}

@keyframes jiDraw { 0% { stroke-dashoffset: 90; } 55%, 100% { stroke-dashoffset: 0; } }
@keyframes jiAreaIn { 0%, 30% { opacity: 0; } 60%, 100% { opacity: 1; } }
@keyframes jiArrowPop { 0%, 60% { opacity: 0; transform: scale(.4); } 70%, 100% { opacity: 1; transform: scale(1); } }
@keyframes jiRide { 0% { offset-distance: 0%; opacity: 1; } 55% { offset-distance: 100%; opacity: 1; } 68%, 100% { offset-distance: 100%; opacity: 0; } }

/* One number to trust · a dart lands dead centre, the ring sweeps round */
.ji-target2 .ring {
  stroke-dasharray: 201;
  transform: rotate(-90deg);
  transform-origin: 42px 42px;
  animation: jiRingHit 3.2s cubic-bezier(.6, 0, .3, 1) both;
}
.ji-target2 .mid,
.ji-target2 .core { transform-origin: 42px 42px; animation: jiRipple 3.2s ease-in-out both; }
.ji-target2 .core { animation-delay: .1s; }
.ji-target2 .dart { animation: jiDart 3.2s cubic-bezier(.5, 0, .9, .5) both; }
.ji-target2 .hit { transform-origin: 42px 42px; animation: jiHit 3.2s ease-out both; }

@keyframes jiRingHit { 0%, 40% { stroke-dashoffset: 201; } 85%, 100% { stroke-dashoffset: 0; } }
@keyframes jiRipple { 0%, 40%, 100% { transform: scale(1); } 48% { transform: scale(1.08); } 58% { transform: scale(.98); } }
@keyframes jiDart {
  0% { opacity: 0; transform: translate(26px, -26px); }
  20% { opacity: 1; transform: translate(26px, -26px); }
  40% { transform: translate(0, 0); }
  100% { opacity: 1; transform: translate(0, 0); }
}
@keyframes jiHit { 0%, 40% { opacity: 0; transform: scale(1); } 42% { opacity: 1; } 75%, 100% { opacity: 0; transform: scale(2.6); } }

@media (prefers-reduced-motion: reduce) {
  .ji * { animation: none !important; }
  .ji-climb .rider { offset-distance: 100%; }
  .ji-target2 .hit { opacity: 0; }
}
.job h3 { font-size: clamp(24px, 1.2vw + 12px, 32px); line-height: 1.15; font-weight: var(--subtitle-weight); }   /* 32px on 16" */
.job p { margin-top: 8px; font-size: 20px; line-height: 1.45; color: var(--fg-3); }

/* The chart under the icons: no divider, no plate */
.redline { margin-top: 64px; }   /* no divider above the chart */

/* The chart starts on the left: its left callout ("Return per $1", about
   140px wide) lines up with the text above, the chart follows it.
   (Was: centred, margin-inline: auto.) */
.rl-chart { max-width: 62%; margin-left: 142px; margin-right: auto; }

.rl-msg {
  min-height: 1.6em;
  margin-bottom: 8px;
  font-size: 20px;
  font-weight: 700;
  color: var(--fg);
}

.rl-plot { position: relative; }

.redline svg { display: block; width: 100%; height: auto; overflow: visible; }
.rl-plot svg { cursor: ew-resize; touch-action: pan-y; }   /* drag the chart sideways; page still scrolls */

.redline svg text {
  font-family: var(--mono);
  font-size: 16px;
  letter-spacing: .06em;
  fill: var(--fg-3);
}

.redline svg .rl-axl { font-size: 15px; text-transform: uppercase; fill: rgba(255, 255, 255, .7); }
/* every line in the chart has round ends */
.redline svg line, #rl-curve { stroke-linecap: round; }

.rl-axis { fill: none; stroke: rgba(255, 255, 255, .28); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
/* the spend already "used" lights up lilac, like the slider's filled part */
.rl-axis-on { stroke: #B8A6F5; stroke-width: 2; stroke-linecap: round; }
.redline.is-over .rl-axis-on { stroke: #FF5C6A; }

/* ---- The handle: a lit sphere (chart) and the same look on the slider ---- */
.rl-knob { cursor: grab; transition: transform .2s cubic-bezier(.23, 1, .32, 1); transform-box: fill-box; transform-origin: center; }
.rl-plot svg:hover .rl-knob { transform: scale(1.12); }
.redline.is-dragging .rl-knob { transform: scale(1.18); cursor: grabbing; }
.redline.is-over #rl-dot { fill: url(#rlBeadBad); }

/* ---- Callouts: a framed label whose frame points at the line ----
   --y (set by sections.js) is the height of the line it explains */
.rl-note {
  position: absolute;
  top: var(--y, 50%);
  display: flex;
  flex-direction: column;
  gap: 2px;
  margin: 0;
  padding: 10px 14px;
  border: 1px solid rgba(255, 255, 255, .5);
  border-radius: 12px;
  background: var(--bg);
  white-space: nowrap;
  line-height: 1.25;
  transform: translateY(-50%);
}

.rl-note::after {                       /* the frame's pointer */
  content: "";
  position: absolute;
  top: 50%;
  width: 10px;
  height: 10px;
  margin-top: -5px;
  background: var(--bg);
  border: inherit;
  border-radius: 0;
  transform: rotate(45deg);
}

.rl-note b { font-size: 17px; font-weight: 500; }
.rl-note span { font-size: 14px; color: var(--fg-2); opacity: .8; }

/* left: points right, at the start of the white curve */
.rl-note--curve { right: calc(100% - 4.4% + 18px); }   /* close to where the white curve starts */
.rl-note--curve::after { right: -6px; border-left: 0; border-bottom: 0; }

/* right: points left, at the end of the red line */
.rl-note--red { left: calc(100% - 2.2% + 18px); border-color: rgba(255, 92, 106, .7); }   /* close to the end of the red line */
.rl-note--red::after { left: -6px; border-right: 0; border-top: 0; }
.rl-note--red b { color: #FF8C96; }

/* "Drag the budget" / state tag above the chart handle */
/* One chip style for every floating label on the page ("Drag the budget",
   "Drag", "12 of 30 tests", "Total so far"): dark fill, 1px light edge,
   a pointer down to what it labels */
.rl-tip {
  position: absolute;
  z-index: 2;
  padding: 7px 12px;
  border: 1px solid rgba(255, 255, 255, .6);
  border-radius: 10px;
  background: var(--bg);
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: .08em;
  text-transform: uppercase;
  white-space: nowrap;
  color: #fff;
  pointer-events: none;
  transform: translate(-50%, calc(-100% - 26px));
  animation: rlBob 2.2s ease-in-out infinite;
  transition: opacity .3s ease, border-color .25s ease, color .25s ease;
}

.rl-tip::after {
  content: "";
  position: absolute;
  left: calc(50% + var(--ax, 0px));   /* pointer can shift to stay over the handle */
  top: 100%;
  width: 10px;
  height: 10px;
  margin: -5px 0 0 -5px;
  border-right: 1px solid rgba(255, 255, 255, .6);
  border-bottom: 1px solid rgba(255, 255, 255, .6);
  background: var(--bg);
  transform: rotate(45deg);
}

.rl-tip.is-ok   { border-color: #B8A6F5; color: #E4DBFF; }
.rl-tip.is-warn { border-color: #F7C35B; color: #FFE3A3; }
.rl-tip.is-bad  { border-color: #FF5C6A; color: #FFB3BA; }
.rl-tip.is-ok::after   { border-color: #B8A6F5; }
.rl-tip.is-warn::after { border-color: #F7C35B; }
.rl-tip.is-bad::after  { border-color: #FF5C6A; }

@keyframes rlBob {
  0%, 100% { transform: translate(-50%, calc(-100% - 26px)); }
  50%      { transform: translate(-50%, calc(-100% - 33px)); }
}

/* ---- Monthly budget: a callout pointing at the slider's start (like
   "Return per $1"), the slider, and its own "Drag" tag ---- */
.rl-range { margin-top: 44px; }

.rl-track { position: relative; }

.rl-note--budget {
  top: 50%;
  right: calc(100% - 4.4% + 18px);
  font-size: 15px;
  font-weight: 500;
  color: #fff;
  cursor: pointer;
}
.rl-note--budget::after { right: -6px; border-left: 0; border-bottom: 0; }

.rl-tip--drag { top: calc(100% - 22px); }   /* anchored at the slider handle's centre, like the chart tag at the dot */

/* Slider: no native frame; thin track lined up with the chart's x range
   (svg 40 → 880 of 900); the handle is the same lit sphere as on the chart */
.slider {
  -webkit-appearance: none;
  appearance: none;
  display: block;
  width: calc(100% * 840 / 900);
  height: 44px;              /* comfortable touch target */
  margin: 0 0 0 calc(100% * 40 / 900);
  background: transparent;
  cursor: grab;
  --fill: 38%;
  --c: #B8A6F5;
  --knob: radial-gradient(circle at 35% 30%, #F3EEFF 0, #C4B2FF 45%, #7C4DEB 100%);
}

.slider:active { cursor: grabbing; }
.slider.is-over { --c: #FF5C6A; --knob: radial-gradient(circle at 35% 30%, #FFE4E7 0, #FF8C96 45%, #D93A4A 100%); }

.slider::-moz-range-track { height: 6px; border-radius: 99px; background: rgba(255, 255, 255, .18); }
.slider::-moz-range-progress { height: 6px; border-radius: 99px; background: var(--c); }

/* Handle: a simple lilac bead, lighter on top and deeper below so it
   reads as slightly raised; a thin white edge. Hover: a soft halo.
   Holding it: it presses in a little and the halo grows. The chart dot
   uses the same bead. Track: a light line, lilac up to the handle. */
.slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 22px;                       /* same size as the dot on the chart */
  height: 22px;
  margin-top: -8px;
  border: 2px solid #fff;
  border-radius: 50%;
  background: linear-gradient(180deg, #D6CBFF, #9B7BF2);
  box-shadow: 0 3px 8px rgba(0, 0, 0, .4);
  transition: transform .18s cubic-bezier(.23, 1, .32, 1), box-shadow .2s ease;
}

.slider::-moz-range-thumb {
  width: 18px;
  height: 18px;
  border: 2px solid #fff;
  border-radius: 50%;
  background: linear-gradient(180deg, #D6CBFF, #9B7BF2);
  box-shadow: 0 3px 8px rgba(0, 0, 0, .4);
}

.slider:hover::-webkit-slider-thumb { box-shadow: 0 3px 8px rgba(0, 0, 0, .4), 0 0 0 7px rgba(184, 166, 245, .18); }
.slider:active::-webkit-slider-thumb { transform: scale(.92); box-shadow: 0 1px 4px rgba(0, 0, 0, .4), 0 0 0 11px rgba(184, 166, 245, .25); }
.slider.is-over::-webkit-slider-thumb { background: linear-gradient(180deg, #FFC2C8, #F2505F); }
.slider.is-over::-moz-range-thumb { background: linear-gradient(180deg, #FFC2C8, #F2505F); }

.slider::-webkit-slider-runnable-track {
  height: 6px;
  border-radius: 99px;
  background: linear-gradient(90deg, var(--c) var(--fill), rgba(255, 255, 255, .18) var(--fill));
}

.slider:focus { outline: none; }
.slider:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px #fff; }
.slider:focus-visible::-moz-range-thumb { box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px #fff; }

/* ---- Under the chart: the promise first (bigger), the caveat after ---- */
.rl-foot { margin-top: 26px; padding-left: calc(100% * 40 / 900); }   /* starts where the chart starts */
.rl-foot-strong { font-size: 16px; font-weight: 400; line-height: 1.45; color: #fff; }   /* body text level */
.rl-foot-note { margin-top: 6px; }

@media (max-width: 1023px) {
  .rl-chart { max-width: none; margin-left: 0; }

  /* No room beside the chart: the callouts sit under it, side by side */
  .rl-plot { display: flex; flex-wrap: wrap; gap: 12px; }
  .rl-plot svg { flex: 0 0 100%; }
  .rl-note { position: static; transform: none; }
  .rl-note::after { display: none; }
  .rl-note--budget { align-self: flex-start; margin: 0 0 48px calc(100% * 40 / 900); }
  /* the chart is small here: a bigger handle so it can be seen and grabbed */

  .rl-track { display: flex; flex-direction: column; }
}

@media (prefers-reduced-motion: reduce) {
  .rl-tip { animation: none; }
}

@media (max-width: 767px) {
  /* The 900-unit-wide chart shrinks ~3×: bigger SVG text keeps labels readable */
  .redline svg text { font-size: 28px; }
  .redline svg .rl-axl { font-size: 26px; }
}


/* ==========================================================================
   6. THE DOUBT · each doubt as a quote, our answer under it
   One card per doubt (frame), a white quote mark, the doubt in regular
   weight; our answer in a gradient-outlined bubble with our logo shape.
   ========================================================================== */
.dbt {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
  gap: 40px;                         /* 40px between all cards, rows and columns */
  margin-top: 44px;
}

.dbt-card {
  position: relative;
  display: grid;
  grid-template-rows: auto 1fr;
  gap: 18px;
  padding: 22px;
  border: 1px solid rgba(255, 255, 255, .28);  /* thin light line, always (was .12, then .7) */
  border-radius: 22px;
  /* frosted glass, opaque enough that an overlapping card stays readable */
  background: linear-gradient(160deg, rgba(40, 42, 64, .92), rgba(24, 26, 43, .92));
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .08), 0 24px 60px rgba(0, 0, 0, .35);
}

/* ---- Large screens: squarer cards, straight, all identical ----
   Three columns × two rows. On scroll they arrive one by one (1 → 6)
   and settle into place. */
@media (min-width: 1024px) {
  /* every card the same size, same text sizes, same position in its cell */
  .dbt {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    align-items: stretch;
    gap: 32px;
    max-width: 90%;                    /* cards 10% smaller */
  }

  .dbt-card {
    min-height: 216px;                 /* squarer; 10% smaller (was 240px) */
    padding: 25px;
    grid-template-rows: auto 1fr;
  }
}

/* order of arrival: 1 → 6 */
.dbt-card:nth-child(2) { --i: 1; }
.dbt-card:nth-child(3) { --i: 2; }
.dbt-card:nth-child(4) { --i: 3; }
.dbt-card:nth-child(5) { --i: 4; }
.dbt-card:nth-child(6) { --i: 5; }

/* ---- Motion: dealt from a stack, then weightless ----
   sections.js deals the cards one by one from the middle of the group to
   their places (a soft spring), then marks each one .landed. A landed card
   shows its doubt, a short "typing…", then our answer, and starts to drift
   on its own slow rhythm, a few pixels, as if floating. */
.dbt.js .dbt-card:not(.landed) { opacity: 0; }

.dbt.js .dbt-card:not(.landed) .dbt-q,
.dbt.js .dbt-card:not(.landed) .dbt-a { opacity: 0; }

.dbt.js .landed .dbt-q { animation: dbtIn .45s cubic-bezier(.23, 1, .32, 1) .05s both; }
.dbt.js .landed .dbt-a { animation: dbtIn .5s cubic-bezier(.23, 1, .32, 1) .95s both; }

.dbt.js .landed { animation: dbtDrift var(--drift, 8s) ease-in-out var(--phase, 0s) infinite; }

/* each card floats on its own path and tempo */
.dbt-card:nth-child(1) { --drift: 8.2s; --phase: -1.2s; --dx: 3px;  --dy: -7px; }
.dbt-card:nth-child(2) { --drift: 9.6s; --phase: -4.1s; --dx: -4px; --dy: -6px; }
.dbt-card:nth-child(3) { --drift: 7.4s; --phase: -2.6s; --dx: 2px;  --dy: -8px; }
.dbt-card:nth-child(4) { --drift: 10s;  --phase: -6.3s; --dx: -3px; --dy: -7px; }
.dbt-card:nth-child(5) { --drift: 8.8s; --phase: -3.4s; --dx: 4px;  --dy: -5px; }
.dbt-card:nth-child(6) { --drift: 9.2s; --phase: -5.5s; --dx: -2px; --dy: -8px; }

@keyframes dbtDrift {
  0%, 100% { translate: 0 0; }
  33%      { translate: var(--dx) var(--dy); }
  66%      { translate: calc(var(--dx) * -.6) calc(var(--dy) * .45); }
}

/* No hover: the cards don't lead anywhere, so they keep one look
   (was: a lighter frame and deeper shadow under the pointer) */

@media (prefers-reduced-motion: reduce) {
  .dbt.js .landed { animation: none; }
}

.dbt-q {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  margin: 0;
  font-size: 20px;
  line-height: 1.4;
  font-style: italic;                /* reads as a quote */
  color: #fff;
}

/* A round, chubby quote mark in white */
.dbt-qm {
  flex: 0 0 auto;
  width: 24px;
  height: 17px;
  margin-top: 4px;
  fill: #fff;
}

.dbt-a {
  position: relative;
  z-index: 1;
  align-self: start;
  margin: 0 0 0 38px;                /* starts under the doubt's text (quote mark 24 + gap 14) */
  padding: 0 0 0 30px;               /* no frame: just our mark and the answer */
  font-size: 18px;
  line-height: 1.5;
}

.dbt-a b { font-weight: 700; color: #fff; }

.dbt-mark {
  position: absolute;
  left: 0;
  top: 5px;
  width: 16px;                       /* 10% smaller again (was 18px) */
  height: 16px;
  background: #fff;                  /* white (was the orange → violet gradient) */
  -webkit-mask: url("../assets/logos/shapeLogo.svg") center / contain no-repeat;
  mask: url("../assets/logos/shapeLogo.svg") center / contain no-repeat;
}

/* Inside a landed card: the doubt, "typing…", our answer */
.dbt.js .dbt-q,
.dbt.js .dbt-a { opacity: 0; transform: translateY(8px); }

.dbt.js .dbt-a,
.dbt.js .landed::after { grid-row: 2; grid-column: 1; }

.dbt.js .landed::after {
  content: "";
  margin-left: 38px;                 /* under the doubt's text, like the answer */
  justify-self: start;
  align-self: start;
  width: 58px;
  height: 30px;
  border-radius: 15px;
  background:
    radial-gradient(circle at 16px 15px, #fff 3px, transparent 3.5px),
    radial-gradient(circle at 29px 15px, #fff 3px, transparent 3.5px),
    radial-gradient(circle at 42px 15px, #fff 3px, transparent 3.5px),
    rgba(255, 255, 255, .08);
  animation: dbtTyping .6s ease .3s both;   /* gone by the time the answer lands */
}

/* typed answer: each letter appears in turn (sections.js) */
.dbt.js .dbt-a .ch { opacity: 0; }
.dbt.js .dbt-a .ch.on { opacity: 1; }

@keyframes dbtIn { to { opacity: 1; transform: none; } }
@keyframes dbtTyping { 0% { opacity: 0; } 15%, 85% { opacity: 1; } 100% { opacity: 0; } }

@media (max-width: 767px) {
  .dbt-card { padding: 18px; }
  .dbt-q { font-size: 18px; }
  .dbt-a { font-size: 16px; }
}


/* ==========================================================================
   7. THE METHOD · tabs: "The growth" chart and "The loop" diagram
   ========================================================================== */
.cr-title { margin-top: clamp(40px, 5vw, 64px); }   /* "The growth" / "The loop" titles (were tabs) */

.cr-panel { animation: fadeUp .45s ease both; }
.cr-panel .cl,
.cr-panel .gw { margin-top: clamp(20px, 3vw, 36px); }
.cr-panel .gw-head { margin-top: 0; }

/* ---- 7a. Growth chart: most tests lose, winners pay for all ---- */
/* Title and text: same levels as the section's own title and intro */
.gw-head { margin-top: 18px; }

.gw-head h3 {
  max-width: none;                   /* two lines, split by <br> (was 22ch) */
  font-size: clamp(30px, 2.6vw + 8px, 46px);
  line-height: 1.05;
  font-weight: 800;
  letter-spacing: -.025em;
  color: #fff;
}

.gw-board {
  margin-top: 48px;                  /* twice the space after the intro (was 24px) */
  padding: clamp(20px, 6vw, 100px);    /* generous space on the sides and bottom */
  padding-top: clamp(12px, 3.6vw, 60px);   /* 40% less above the message (was 100px) */
  /* the same frame as the "You've Heard it Before" cards: a thin light line */
  border: 1px solid rgba(255, 255, 255, .28);
  border-radius: 22px;
  background: linear-gradient(160deg, rgba(40, 42, 64, .92), rgba(24, 26, 43, .92));
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .08), 0 24px 60px rgba(0, 0, 0, .35);
}

.gw-board svg { display: block; width: 100%; height: auto; overflow: visible; }

.gw-zero { stroke: rgba(255, 255, 255, .3); stroke-width: 1.5; stroke-dasharray: 4 6; }
.gw-axl { font-family: var(--display); font-size: 14px; fill: rgba(255, 255, 255, .7); }

.gw-b path { transition: opacity .35s ease, transform .45s cubic-bezier(.23, 1, .32, 1); transform-box: fill-box; }
/* bars stand on the break-even line: square at the line, rounded at the tip */
.gw-b.loss path { fill: url(#gwLoss); opacity: .85; transform-origin: top; }
.gw-b.win path { fill: url(#gwWin); transform-origin: bottom; }
.gw-b path.er { fill: url(#gwEarn); opacity: 1; transform-origin: bottom; }

.gw-b.win text {
  font-family: var(--mono);
  font-size: 10.5px;
  letter-spacing: .12em;
  fill: #fff;                        /* "WINNER" in white */
  paint-order: stroke;
  stroke: #191B2C;
  stroke-width: 5px;
  stroke-linejoin: round;
  transition: opacity .25s ease;
}

.gw-b.off path { opacity: 0; transform: scaleY(0); }
.gw-b.off text { opacity: 0; }

.gw-line {
  fill: none;
  stroke: #fff;
  stroke-width: 3;
  stroke-linejoin: round;
  stroke-linecap: round;
}

.gw-zero { vector-effect: non-scaling-stroke; }
/* "Total so far" chip rides the end of the curve */
.gw-plot { position: relative; }
.gw-total { transform: translate(-50%, calc(-100% - 14px)); animation: none; }

/* the curve keeps normal scaling so its reveal (dash) lines up with the bars */

.gw-dot { fill: #fff; stroke: #111320; stroke-width: 3; }   /* white, not orange */

/* What is happening right now: the chart's live headline, above it.
   It flashes in each time it changes, so the change is noticed. */
.gw-msg {
  max-width: 32ch;                   /* reads as two lines */
  min-height: 2.6em;
  margin-bottom: 4px;                /* the chart sits close under it */
  font-size: clamp(20px, 1vw + 12px, 28px);
  font-weight: 500;
  line-height: 1.3;
  color: #fff;
}

.gw-msg.is-new { animation: gwMsg .5s cubic-bezier(.23, 1, .32, 1); }

@keyframes gwMsg {
  from { opacity: 0; transform: translateY(8px); filter: blur(3px); }
  to   { opacity: 1; transform: none; filter: none; }
}

/* Under the chart: the key, then the slider with its title beside it */
.gw-ctl { margin-top: 0; }   /* slider pulled up to the chart */

.gw-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 22px;
  margin-top: 26px;                  /* the key comes last */
  font-size: 15px;
  color: var(--fg-2);
}

.gw-legend span { display: inline-flex; align-items: center; gap: 8px; }
.gw-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; }
.gw-legend i.l { background: #FF5C6A; }
.gw-legend i.e { background: rgba(74, 222, 155, .3); }
.gw-legend i.w { background: #4ADE9B; }
.gw-legend i.t { width: 16px; height: 3px; border-radius: 2px; background: #fff; }
.gw-legend i.z { width: 16px; height: 0; border-radius: 0; border-top: 2px dashed rgba(255, 255, 255, .5); }
.gw-legend b { color: #fff; font-weight: 500; }

/* Title above the slider; the slider runs the full width of the chart */
.gw-row { margin-top: 0; }


.gw-label b { font-weight: 600; }

.gw-track { position: relative; padding-top: 56px; }   /* room for the chip over the handle */
.gw-track .rl-tip--drag { top: calc(100% - 22px); transform: translate(-50%, calc(-100% - 34px)); animation: none; }   /* over the handle */
.gw-ctl .slider.gw-slider { width: 100%; margin: 0; --c: #fff; }

.gw-cap { margin-top: 12px; }

/* Compact chart (phones): JS adds .compact, labels move below the chart */

.gw-board svg.compact { height: 230px; }
.gw-board svg.compact text,
.gw-board svg.compact .gw-dot { display: none; }



/* ---- 7b. Creative loop: ring diagram + step panel ---- */
.cl {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
  gap: clamp(20px, 3vw, 40px);
  align-items: center;
  margin-top: clamp(32px, 4vw, 52px);
}

.cl-ring svg { display: block; width: 100%; height: auto; overflow: visible; }

.cl-seg { fill: none; stroke: none; }
.cl-track,
.cl-lead { fill: none; stroke: rgba(255, 255, 255, .1); stroke-width: 2; }
.cl-track2,
.cl-lead2 { fill: none; stroke: rgba(242, 137, 58, .45); stroke-width: 2; }

.cl-back {
  fill: none;
  stroke: #B8A6F5;
  stroke-width: 1.8;
  stroke-dasharray: 3 7;
  stroke-linecap: round;
