/* The method: both intros (under the section title and under "Most tests
   lose") a little wider, so they read in two lines instead of three */
#ch-creative .sub { max-width: 1040px; }

/* The pain: a cause's frame is dashed while its links are dashed (not
   chosen) and turns solid when it lights up, like its lines. The causes' label sits close
   above them (the column's 44px gap is for the arc, not the label). */
/* Symptoms: a thin, light, solid white frame (the dashes are for the causes) */
.sym { border: 1px solid rgba(255, 255, 255, .5); }
.sym[aria-pressed="true"] { border-color: #fff; }
.cause { border-style: dashed; border-color: rgba(255, 255, 255, .3); }
.cause.on { border-style: solid; border-color: var(--violet); }
.tree .col:last-child h3 { margin-bottom: -26px; }   /* 18px to the first cause, like the symptoms */
@media (max-width: 767px) {
  .tree .col:last-child h3 { margin-bottom: -4px; }
}

/* Eyebrow → title: one gap everywhere, the one under "Back to leading"
   (14px on large screens, 6px on phones). "The Growth" had 36px / 20px,
   section titles 8px and the closing title 14px on phones. */
.cr-panel .gw { margin-top: 14px; }
@media (max-width: 767px) {
  .h2,
  .close h2,
  .cr-panel .gw { margin-top: 6px; }
}
