/* Symptoms: see-through with a bright white outline, lighter text */
.sym {
  padding: 14px 18px;
  border: 1.5px solid #fff;
  border-radius: 16px;
  background: transparent;
  color: #fff;
  font-family: var(--display);
  font-size: 16.5px;
  font-weight: 400;          /* was 600 on a white fill */
  line-height: 1.3;
  text-align: left;
  cursor: pointer;
  transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
}

.sym:hover { background: rgba(255, 255, 255, .06); }
.sym:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }

/* Selected: a soft white fill, no orange */
.sym[aria-pressed="true"] {
  background: rgba(255, 255, 255, .14);
  box-shadow: 0 0 0 1px #fff, 0 12px 34px rgba(255, 255, 255, .08);
  /* no sideways nudge: the links start exactly at the frame's edge
     (was translateX(4px), which pushed the frame over its lines) */
}

/* Causes sit on a half-circle opening towards the symptoms: the ends stay
   close, the middle ones curve away to the right. Twice the space between
   them (was 22px; arc was 0 / 40 / 62px). */
.tree .col:last-child { gap: 44px; }
.cause:nth-of-type(2), .cause:nth-of-type(4) { transform: translateX(72px); }
.cause:nth-of-type(3) { transform: translateX(100px); }

.cause {
  padding: 14px 18px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--panel);
  color: var(--fg-3);
  font-size: 16.5px;
  font-weight: 600;          /* was 700 */
  line-height: 1.3;
  transition: border-color .35s ease, background .35s ease, color .35s ease, box-shadow .35s ease;
}

.cause small {
  display: block;
  margin-top: 6px;
  font-size: 14px;
  font-weight: 400;
  color: var(--fg-3);
  transition: color .3s ease;
}

.cause.on {
  border-color: var(--violet);
  background: linear-gradient(100deg, rgba(139, 92, 246, .22), rgba(139, 92, 246, .08));
  color: #fff;
}

.cause.on small { color: var(--fg-2); }

/* The moment the light arrives: a short lilac glow around the cause */
.cause.hit { animation: causeHit .9s cubic-bezier(.23, 1, .32, 1); }

@keyframes causeHit {
  0%   { box-shadow: 0 0 0 0 rgba(155, 123, 242, .65), 0 0 0 rgba(155, 123, 242, 0); }
  100% { box-shadow: 0 0 0 10px rgba(155, 123, 242, 0), 0 0 28px rgba(155, 123, 242, .25); }
}

/* Links: every possible link is a thin dashed line. The chosen symptom's
   links light up: a bright line runs out from the symptom (white turning
   lilac) with a glowing head, and the cause lights when it arrives.
   (Was: faint solid lines, the chosen ones plain white.) */
.links path { fill: none; }
.links path.base {
  stroke: rgba(255, 255, 255, .22);
  stroke-width: 1.2;
  stroke-dasharray: 3 5;
}
.links path.flow {
  stroke-width: 1.4;                 /* thin but clear, one weight end to end (was 2 + a glow) */
  stroke-linecap: round;
  opacity: 0;
  transition: opacity .2s ease;
}
.links path.flow.on { opacity: 1; }

@media (max-width: 767px) {
  .tree { grid-template-columns: 1fr; gap: 28px; }
  .tree .gap,
  .tree svg.links { display: none; }
  .cause:nth-of-type(n) { transform: none; }   /* no arc on phones */
  .tree .col:last-child { gap: 22px; }   /* phones keep their spacing */
