.cl-cn { font-family: var(--mono); font-size: 14px; letter-spacing: .14em; fill: #fff; }
.cl-ct { font-family: var(--display); font-size: 38px; font-weight: 800; letter-spacing: -.02em; fill: #fff; }
.cl-cs { font-family: var(--mono); font-size: 12px; letter-spacing: .2em; fill: var(--fg-3); }

.cl-panel {
