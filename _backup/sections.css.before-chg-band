.cl-comet { fill: #F2893A; filter: drop-shadow(0 0 8px rgba(242, 137, 58, .9)); }

.cl-node { cursor: pointer; outline: none; }
.cl-node circle { fill: var(--bg); stroke: var(--line-2); stroke-width: 2; transition: fill .35s ease, stroke .35s ease; }
.cl-node text { font-family: var(--mono); font-size: 14px; fill: var(--fg-2); pointer-events: none; transition: fill .35s ease; }
.cl-node.done circle { stroke: rgba(242, 137, 58, .7); }
.cl-node.on circle { fill: #F2893A; stroke: #F2893A; }
.cl-node.on text { fill: #111320; font-weight: 700; }
.cl-node:hover circle { stroke: #fff; }
